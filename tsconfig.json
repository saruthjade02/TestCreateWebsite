{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "legacy",
    "types": ["node"],
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noEmitOnError": true,
    "outDir": "dir",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "script.ts",
    "server.ts",
    "signup.ts",
    "product.ts",
    "login.ts"
  ]
}

